# Copy to .env (git-ignored) and fill in. Dummy values only — never commit real credentials.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cavella
SPRING_DATASOURCE_USERNAME=cavella_app
SPRING_DATASOURCE_PASSWORD=change-me

# Exact web origins allowed to call the API from a browser (comma-separated).
CAVELLA_CORS_ALLOWED_ORIGINS=https://cavella.example

# Creates the first OWNER account when none exists. Remove after the first start.
CAVELLA_BOOTSTRAP_OWNER_EMAIL=owner@cavella.example
CAVELLA_BOOTSTRAP_OWNER_PASSWORD=change-me-to-12-plus-chars

# Local development: relaxed session cookie for http://localhost (see application-dev.yaml).
# SPRING_PROFILES_ACTIVE=dev
